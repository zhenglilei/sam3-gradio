{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "profile",
    "confidence",
    "selected_candidate_id",
    "observations",
    "assistant_message",
    "manual_review",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "intent": {"enum": ["analyze", "revise", "compare", "explain"]},
    "profile": {"enum": ["ACT", "GE1", "GE2", "Unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "selected_candidate_id": {"type": "string", "pattern": "^C[1-6]$"},
    "observations": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 160}},
    "assistant_message": {"type": "string", "minLength": 1, "maxLength": 500},
    "manual_review": {"type": "boolean"},
    "warnings": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 160}}
  }
}
